# GitHub token with read access to Justin-Developer01/vesper-desk's releases.
# Works with no token while that repo is public, but set it either way: it raises the
# GitHub API rate limit from 60/hour (shared across every visitor) to 5,000/hour.
# Fine-grained PAT scoped to "Contents: read" on that one repo is enough.
GITHUB_TOKEN=

PORT=8787

# The reverse proxy's address(es), comma-separated, trusted to set X-Forwarded-*.
# 127.0.0.1 matches docker-compose's loopback-only port bind (a proxy on the same host,
# e.g. Caddy). Only change this if the proxy reaches this service some other way, such as a
# shared Docker network — then use its address on that network, never a public IP or "*".
TRUSTED_PROXY=127.0.0.1

# The public https:// origin this service is served at, used to build the /v1/download/latest
# URL returned by /v1/download/latest/info. Required in production — never derived from the
# request, which could otherwise carry a spoofed Host header.
PUBLIC_ORIGIN=https://api.vesperdesk.app
